# Gemfile for local development.
# GitHub Pages builds your site automatically, so this is only needed
# if you want to preview the site locally with `bundle exec jekyll serve`.

source "https://rubygems.org"

# Use the github-pages gem so your local build matches GitHub's build exactly.
gem "github-pages", group: :jekyll_plugins

# Plugins used by the site (also whitelisted by GitHub Pages).
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby compatibility helpers.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
